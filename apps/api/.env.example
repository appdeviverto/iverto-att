# Iverto Attendance API — copy to .env (§18)

PORT=8040
NODE_ENV=development
# The proxy strips the public /att prefix; the app serves /v1.
API_PREFIX=v1
# all | api | edge — only "all" exists today (§2.3)
APP_ROLE=all

# Supavisor transaction pooler (6543) for the app — connect as a role WITHOUT BYPASSRLS.
DATABASE_URL="postgres://app_user.REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session port (5432) as a migration role WITH BYPASSRLS: prisma migrate + post-init SQL.
DIRECT_URL="postgres://postgres.REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
DB_POOL_MAX=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

SUPABASE_URL="https://REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_SERVICE_ROLE_KEY"
SUPABASE_JWKS_URL="https://REF.supabase.co/auth/v1/.well-known/jwks.json"

CORS_ORIGIN=
# Which hops may set X-Forwarded-For (fastify trustProxy). Default: loopback (Caddy on the same host).
TRUST_PROXY=loopback

# Forgot-password e-mails (Resend). Without the key, reset mails are only logged.
RESEND_API_KEY=
MAIL_FROM=Iverto Attendance <no-reply@mailservice.iverto.ai>
# Public web app origin; reset links point at <WEB_APP_URL>/reset-password.
WEB_APP_URL=https://attend.iverto.ai

# Private buckets; downloads via 5-minute signed URLs.
STORAGE_BUCKET_REPORTS=reports
STORAGE_BUCKET_UPLOADS=uploads
STORAGE_BUCKET_PUNCH_PHOTOS=punch-photos

# Mobile check-in selfies (Azure Blob, private container, read via 1-hour SAS links).
# The connection string must include AccountKey (SAS links are signed with it).
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=ACCOUNT;AccountKey=KEY;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_SELFIES=punch-selfies
# Confidential HR files: employee documents, letters, payslips, expense receipts (read via 5-minute SAS links).
AZURE_STORAGE_CONTAINER_DOCUMENTS=hr-documents

# Socket.IO path the app receives (clients connect to /att/socket.io through the proxy).
WS_PATH=/socket.io
# Path the APP receives for terminals (device menu: wss://<host>/att/m50). See m50-terminal-integration.md.
M50_WS_PATH=/m50
# Optional second factor checked at Register. Unset: a registered terminal can't re-register until an admin
# re-arms it (Terminals page). Set (and typed into every device's menu): devices re-register on their own.
M50_CLOUD_ID=

# Optional: FCM push; without it pushes are only logged (inbox still works). base64 of the service-account JSON.
FIREBASE_SERVICE_ACCOUNT=

# Set to true on replicas that must not register the repeatable jobs.
DISABLE_CRON=false

# Public developer API (docs/public-api.md). HMAC pepper for API key hashes, signed cursors and
# (derived) webhook-secret encryption:
# ≥ 32 random characters, kept in Azure Key Vault in production. Without it the API refuses every key.
# Rotate: set API_KEY_PEPPER_VERSION=2 with the new value in API_KEY_PEPPER, and keep the old one as API_KEY_PEPPER_V1.
API_KEY_PEPPER=
API_KEY_PEPPER_VERSION=1
# Webhook delivery worker (public-api/webhooks.ts); set to off on replicas that must not send.
WEBHOOK_WORKER=on
# Bulk-upsert job worker (public-api/jobs.ts); off on replicas that must not run jobs.
API_JOB_WORKER=on
