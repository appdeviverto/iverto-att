generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enum-like columns are plain strings with CHECK constraints in
// post-init/002-constraints.sql, matching the hostel convention.

// ── Org ─────────────────────────────────────────────────────────────────────

model Tenant {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  status          String    @default("PROVISIONING") // PROVISIONING | ACTIVE | SUSPENDED
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")
  /// branding, dayBoundary, storePunchPhotos, punchPhotoRetentionDays, reportRetentionDays, adminUserId, …
  settings        Json      @default("{}")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("tenants")
}

model Site {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  name              String
  address           String?
  timezone          String   @default("Asia/Kolkata")
  holidayCalendarId String?  @map("holiday_calendar_id")
  /// Geofence for mobile punches: inside ⇒ auto-approved; outside ⇒ manual review, or refused when strict.
  lat               Float?
  lng               Float?
  geofenceRadiusM   Int?     @map("geofence_radius_m")
  geofenceStrict    Boolean  @default(false) @map("geofence_strict")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at") // set by the api_set_updated_at trigger (post-init/007)

  employees Employee[]
  devices   Device[]

  @@index([tenantId])
  @@index([tenantId, updatedAt, id])
  @@map("sites")
}

model Department {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  name           String
  code           String?
  headEmployeeId String?  @map("head_employee_id")
  policyId       String?  @map("policy_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at") // set by the api_set_updated_at trigger (post-init/007)

  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId, updatedAt, id])
  @@map("departments")
}

model Project {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  code      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  members EmployeeProject[]

  @@unique([tenantId, name])
  @@map("projects")
}

model EmployeeProject {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  employeeId String    @map("employee_id")
  projectId  String    @map("project_id")
  from       DateTime  @db.Date
  to         DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([employeeId])
  @@map("employee_projects")
}

model HolidayCalendar {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  holidays Holiday[]

  @@map("holiday_calendars")
}

model Holiday {
  id         String          @id @default(cuid())
  tenantId   String          @map("tenant_id")
  calendarId String          @map("calendar_id")
  calendar   HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date       DateTime        @db.Date
  name       String

  @@unique([calendarId, date])
  @@map("holidays")
}

/// Thresholds for the attendance engine (§6.2). One default per tenant, optional per department.
model AttendancePolicy {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  name                  String
  isDefault             Boolean  @default(false) @map("is_default")
  graceInMinutes        Int      @default(10) @map("grace_in_minutes")
  graceOutMinutes       Int      @default(10) @map("grace_out_minutes")
  /// Percent of required minutes.
  halfDayMinPercent     Int      @default(50) @map("half_day_min_percent")
  fullDayMinPercent     Int      @default(90) @map("full_day_min_percent")
  earlyWindowMinutes    Int      @default(180) @map("early_window_minutes")
  lateWindowMinutes     Int      @default(360) @map("late_window_minutes")
  duplicatePunchSeconds Int      @default(60) @map("duplicate_punch_seconds")
  minSessionMinutes     Int      @default(5) @map("min_session_minutes")
  absentAfterMinutes    Int      @default(120) @map("absent_after_minutes")
  missedOutCredit       String   @default("NONE") @map("missed_out_credit") // NONE | UNTIL_SHIFT_END
  overtimeEnabled       Boolean  @default(false) @map("overtime_enabled")
  overtimeMinMinutes    Int      @default(30) @map("overtime_min_minutes")
  breakDeduction        String   @default("SHIFT_BREAK") @map("break_deduction") // SHIFT_BREAK | NONE
  roundingMinutes       Int      @default(0) @map("rounding_minutes")
  minRestHours          Int      @default(8) @map("min_rest_hours")
  maxWeeklyHours        Int      @default(60) @map("max_weekly_hours")
  /// Every `lateDeductionEvery` late days in a month deducts this much attendance.
  lateDeduction         String   @default("NONE") @map("late_deduction") // NONE | HALF_DAY | FULL_DAY
  lateDeductionEvery    Int      @default(2) @map("late_deduction_every")
  /// Late penalty also counts early exits (an early exit without approved permission).
  earlyExitCountsAsLate Boolean  @default(false) @map("early_exit_counts_as_late")
  /// Days deducted per absent working day (no approved leave). 1.5 = "unauthorised leave costs 1.5 days".
  absenceDeduction      Float    @default(1) @map("absence_deduction")
  /// Bidirectional-terminal punches: FIRST_LAST = one session; ALTERNATE = in, out, in, out (multiple sessions a day).
  pairing               String   @default("FIRST_LAST")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("attendance_policies")
}

// ── People & access ─────────────────────────────────────────────────────────

/// One Supabase auth user. Platform admins have no tenant.
model UserProfile {
  userId              String    @id @map("user_id")
  tenantId            String?   @map("tenant_id")
  employeeId          String?   @unique @map("employee_id")
  role                String // ADMIN | HR | MANAGER | EMPLOYEE | PLATFORM_ADMIN
  displayName         String    @map("display_name")
  email               String
  siteIds             String[]  @default([]) @map("site_ids")
  status              String    @default("ACTIVE") // ACTIVE | DISABLED | EXITED
  mustChangePassword  Boolean   @default(true) @map("must_change_password")
  /// Platform announcements published before this were shown (org admins); null = none yet.
  announcementsSeenAt DateTime? @map("announcements_seen_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("user_profiles")
}

model Employee {
  id                 String    @id @default(cuid())
  tenantId           String    @map("tenant_id")
  siteId             String    @map("site_id")
  departmentId       String?   @map("department_id")
  managerId          String?   @map("manager_id")
  employeeCode       String    @map("employee_code")
  /// The integrator's own id for this person (public API); unique per tenant.
  externalId         String?   @map("external_id")
  fullName           String    @map("full_name")
  email              String?
  phone              String?
  designation        String?
  employmentType     String    @default("FULL_TIME") @map("employment_type")
  joinedOn           DateTime  @map("joined_on") @db.Date
  exitOn             DateTime? @map("exit_on") @db.Date
  mobilePunch        String    @default("NEVER") @map("mobile_punch") // NEVER | REMOTE_DAYS | ALWAYS | FULL_REMOTE
  /// Per-person override of the leave policy: { [leaveTypeId]: amount per accrual }; 0 = not eligible.
  leaveEntitlements  Json      @default("{}") @map("leave_entitlements")
  status             String    @default("ACTIVE") // ACTIVE | EXITED
  userId             String?   @unique @map("user_id")
  biometricConsentAt DateTime? @map("biometric_consent_at")
  biometricConsentBy String?   @map("biometric_consent_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Directory (all nullable: added to a live table without touching existing rows).
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  gender             String? // MALE | FEMALE | OTHER
  maritalStatus      String?   @map("marital_status") // SINGLE | MARRIED | OTHER
  bloodGroup         String?   @map("blood_group")
  fatherOrSpouseName String?   @map("father_or_spouse_name")
  personalEmail      String?   @map("personal_email")
  altPhone           String?   @map("alt_phone")
  currentAddress     String?   @map("current_address")
  permanentAddress   String?   @map("permanent_address")
  emergencyName      String?   @map("emergency_name")
  emergencyRelation  String?   @map("emergency_relation")
  emergencyPhone     String?   @map("emergency_phone")
  /// Sensitive (HR/admin + self only): PAN, UAN, ESIC, bank.
  pan                String?
  /// Never the full Aadhaar number (Aadhaar Act); the card scan goes in the document vault.
  aadhaarLast4       String?   @map("aadhaar_last4")
  uan                String?
  esicNumber         String?   @map("esic_number")
  bankAccountName    String?   @map("bank_account_name")
  bankAccountNumber  String?   @map("bank_account_number")
  bankIfsc           String?   @map("bank_ifsc")
  bankName           String?   @map("bank_name")
  paymentMode        String?   @map("payment_mode") // BANK | CASH | CHEQUE; null = BANK
  probationEndOn     DateTime? @map("probation_end_on") @db.Date
  confirmedOn        DateTime? @map("confirmed_on") @db.Date
  noticePeriodDays   Int?      @map("notice_period_days")

  site           Site                   @relation(fields: [siteId], references: [id])
  department     Department?            @relation(fields: [departmentId], references: [id])
  manager        Employee?              @relation("Reports", fields: [managerId], references: [id])
  reports        Employee[]             @relation("Reports")
  days           AttendanceDay[]
  punches        Punch[]
  leaveRequests  LeaveRequest[]
  remoteRequests RemoteWorkRequest[]
  corrections    AttendanceCorrection[]
  projects       EmployeeProject[]
  fieldVisits    FieldVisit[]
  profileChanges ProfileChangeRequest[]
  documents      EmployeeDocument[]
  tasks          EmployeeTask[]
  expenses       ExpenseClaim[]
  assets         Asset[]
  salaries       EmployeeSalary[]
  adjustments    PayrollAdjustment[]
  loans          EmployeeLoan[]
  payslips       Payslip[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, externalId])
  @@index([tenantId, updatedAt, id])
  @@index([tenantId, status])
  @@index([managerId])
  @@index([departmentId])
  @@map("employees")
}

// ── Terminals (copied from hostel, trimmed to M50) ──────────────────────────

model Device {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  siteId        String    @map("site_id")
  serialNo      String    @unique @map("serial_no")
  name          String?
  gateName      String    @map("gate_name")
  direction     String // IN | OUT | BOTH
  clockTimezone String?   @map("clock_timezone") // null ⇒ site timezone
  terminalToken String?   @map("terminal_token")
  terminalType  String?   @map("terminal_type")
  status        String    @default("provisioned") // provisioned | registered | online | offline
  lastSeenAt    DateTime? @map("last_seen_at")
  /// Backfill cursor: highest LogID durably ingested (LogID, NOT position).
  lastLogId     Int?      @map("last_log_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  site          Site           @relation(fields: [siteId], references: [id])
  terminalUsers TerminalUser[]
  punches       Punch[]

  @@index([tenantId])
  @@map("devices")
}

/// Maps a terminal's device-local UserID (1..99999999) to an employee.
model TerminalUser {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  deviceId       String    @map("device_id")
  device         Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  terminalUserId Int       @map("terminal_user_id")
  subjectType    String    @default("EMPLOYEE") @map("subject_type")
  subjectId      String    @map("subject_id")
  faceEnrolled   Boolean   @default(false) @map("face_enrolled")
  enrolledAt     DateTime? @map("enrolled_at")
  /// Set once the user is deleted from the device on offboarding. The row stays
  /// so the slot number is never handed to anyone else.
  releasedAt     DateTime? @map("released_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([deviceId, terminalUserId])
  @@unique([deviceId, subjectType, subjectId])
  @@index([subjectId])
  @@map("terminal_users")
}

/// Opaque vendor face templates harvested with GetFaceData.
model TerminalFaceTemplate {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  subjectType    String   @default("EMPLOYEE") @map("subject_type")
  subjectId      String   @map("subject_id")
  vendor         String
  terminalType   String?  @map("terminal_type")
  template       String
  templateSha256 String   @map("template_sha256")
  sourceDeviceId String?  @map("source_device_id")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([subjectType, subjectId, vendor])
  @@index([tenantId])
  @@map("terminal_face_templates")
}

// ── Punches & attendance ────────────────────────────────────────────────────

/// Immutable. Corrections are new rows with source = CORRECTION (D5).
model Punch {
  id             String    @default(cuid())
  punchedAt      DateTime  @map("punched_at") @db.Timestamptz(3)
  tenantId       String    @map("tenant_id")
  siteId         String    @map("site_id")
  employeeId     String?   @map("employee_id") // null = UNKNOWN slot
  deviceId       String?   @map("device_id")
  terminalUserId Int?      @map("terminal_user_id")
  deviceLogId    Int?      @map("device_log_id")
  source         String // TERMINAL | MOBILE | CORRECTION | MANUAL
  direction      String // in | out | unknown
  outcome        String    @default("GRANTED") // GRANTED | DENIED | UNKNOWN
  workDate       DateTime? @map("work_date") @db.Date
  lat            Float?
  lng            Float?
  accuracy       Float?
  isMockLocation Boolean?  @map("is_mock_location")
  correctionId   String?   @map("correction_id")
  reason         String?
  createdBy      String?   @map("created_by")
  photoKey       String?   @map("photo_key") // Azure blob key of the MOBILE selfie
  reviewStatus   String?   @map("review_status") // MOBILE only: PENDING | APPROVED | REJECTED
  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  reviewNote     String?   @map("review_note")
  receivedAt     DateTime  @default(now()) @map("received_at")
  updatedAt      DateTime  @default(now()) @map("updated_at") // set by the api_set_updated_at trigger (post-init/007)

  employee Employee? @relation(fields: [employeeId], references: [id])
  device   Device?   @relation(fields: [deviceId], references: [id])

  @@id([id, punchedAt])
  @@unique([deviceId, deviceLogId, punchedAt])
  @@index([employeeId, punchedAt])
  @@index([siteId, punchedAt])
  @@index([tenantId, punchedAt])
  @@index([tenantId, updatedAt, id])
  @@index([tenantId, reviewStatus, punchedAt])
  @@map("punches")
}

/// One row per employee per work date. Materialised ahead (§7.2), recomputed on every change (D4).
model AttendanceDay {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  siteId            String    @map("site_id")
  employeeId        String    @map("employee_id")
  workDate          DateTime  @map("work_date") @db.Date
  timezone          String
  dayType           String    @map("day_type") // WORKING | WEEKLY_OFF | HOLIDAY
  holidayName       String?   @map("holiday_name")
  shiftId           String?   @map("shift_id")
  shiftKind         String?   @map("shift_kind") // FIXED | FLEXIBLE
  shiftBreakMinutes Int       @default(0) @map("shift_break_minutes")
  schedStart        DateTime? @map("sched_start") @db.Timestamptz(3)
  schedEnd          DateTime? @map("sched_end") @db.Timestamptz(3)
  coreStart         DateTime? @map("core_start") @db.Timestamptz(3)
  coreEnd           DateTime? @map("core_end") @db.Timestamptz(3)
  windowStart       DateTime  @map("window_start") @db.Timestamptz(3)
  windowEnd         DateTime  @map("window_end") @db.Timestamptz(3)
  requiredMinutes   Int       @default(0) @map("required_minutes")
  policyId          String?   @map("policy_id")
  /// The policy values this day is judged with, frozen at materialisation.
  policy            Json      @default("{}")
  firstIn           DateTime? @map("first_in") @db.Timestamptz(3)
  lastOut           DateTime? @map("last_out") @db.Timestamptz(3)
  segments          Json      @default("[]")
  workedMinutes     Int       @default(0) @map("worked_minutes")
  breakMinutes      Int       @default(0) @map("break_minutes")
  lateMinutes       Int       @default(0) @map("late_minutes")
  earlyExitMinutes  Int       @default(0) @map("early_exit_minutes")
  overtimeMinutes   Int       @default(0) @map("overtime_minutes")
  punchCount        Int       @default(0) @map("punch_count")
  status            String    @default("PENDING")
  liveState         String    @default("NOT_YET_IN") @map("live_state")
  isLate            Boolean   @default(false) @map("is_late")
  isEarlyExit       Boolean   @default(false) @map("is_early_exit")
  missedPunch       Boolean   @default(false) @map("missed_punch")
  workedOnOffDay    Boolean   @default(false) @map("worked_on_off_day")
  hasLeaveConflict  Boolean   @default(false) @map("has_leave_conflict")
  leavePortion      Decimal   @default(0) @map("leave_portion") @db.Decimal(2, 1)
  leaveHalf         String?   @map("leave_half") // FIRST | SECOND
  leaveTypeId       String?   @map("leave_type_id")
  /// Approved hourly leave (permission) on this day.
  permissionMinutes Int       @default(0) @map("permission_minutes")
  remote            Boolean   @default(false)
  corrected         Boolean   @default(false)
  finalizedAt       DateTime? @map("finalized_at")
  computedAt        DateTime  @default(now()) @map("computed_at")
  updatedAt         DateTime  @default(now()) @map("updated_at") // set by the api_set_updated_at trigger (post-init/007)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@index([tenantId, workDate, status])
  @@index([tenantId, updatedAt, id])
  @@index([siteId, workDate])
  @@index([windowEnd, finalizedAt])
  @@map("attendance_days")
}

model AttendanceCorrection {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  employeeId    String    @map("employee_id")
  workDate      DateTime  @map("work_date") @db.Date
  inAt          DateTime? @map("in_at") @db.Timestamptz(3)
  outAt         DateTime? @map("out_at") @db.Timestamptz(3)
  reason        String
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  requestedBy   String    @map("requested_by")
  approverId    String?   @map("approver_id")
  decidedAt     DateTime? @map("decided_at")
  decisionNote  String?   @map("decision_note")
  /// Proof the employee attached: field visits taken in the app (e.g. one per client visited that day).
  fieldVisitIds String[]  @default([]) @map("field_visit_ids")
  createdAt     DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([employeeId, workDate])
  @@map("attendance_corrections")
}

/// A geotagged, timestamped selfie taken in the mobile app while working off-site
/// (e.g. at a client's). Never counts as a punch; it is attached to a correction as proof.
model FieldVisit {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  employeeId     String   @map("employee_id")
  /// Server time when received — the device clock is not trusted (§9).
  takenAt        DateTime @map("taken_at") @db.Timestamptz(3)
  lat            Float
  lng            Float
  accuracy       Float
  isMockLocation Boolean? @map("is_mock_location")
  photoKey       String   @map("photo_key") // Azure blob key, same container as mobile punch selfies
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, takenAt])
  @@map("field_visits")
}

// ── Schedule ────────────────────────────────────────────────────────────────

model Shift {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  name            String
  code            String
  color           String   @default("#cd0447")
  kind            String   @default("FIXED") // FIXED | FLEXIBLE
  /// Local wall-clock "HH:mm" in the employee's site timezone.
  startTime       String   @map("start_time")
  endTime         String   @map("end_time")
  breakMinutes    Int      @default(0) @map("break_minutes")
  requiredMinutes Int      @map("required_minutes")
  coreStart       String?  @map("core_start")
  coreEnd         String?  @map("core_end")
  worksHolidays   Boolean  @default(false) @map("works_holidays")
  policyId        String?  @map("policy_id")
  isDefault       Boolean  @default(false) @map("is_default")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([tenantId, code])
  @@map("shifts")
}

model ShiftPattern {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  cycleDays Int      @map("cycle_days")
  /// Array of shift id | null (off), length = cycleDays.
  days      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("shift_patterns")
}

model EmployeeSchedule {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  employeeId    String    @map("employee_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  shiftId       String?   @map("shift_id")
  /// 0 = Sunday … 6 = Saturday
  weeklyOffs    Int[]     @default([]) @map("weekly_offs")
  patternId     String?   @map("pattern_id")
  anchorDate    DateTime? @map("anchor_date") @db.Date
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([employeeId, effectiveFrom])
  @@map("employee_schedules")
}

model RosterOverride {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  employeeId String   @map("employee_id")
  date       DateTime @db.Date
  shiftId    String?  @map("shift_id") // null = off
  reason     String?
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([employeeId, date])
  @@map("roster_overrides")
}

// ── Leave ───────────────────────────────────────────────────────────────────

model LeaveType {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  code                String
  name                String
  color               String   @default("#2563eb")
  paid                Boolean  @default(true)
  active              Boolean  @default(true)
  allowHalfDay        Boolean  @default(true) @map("allow_half_day")
  /// DAYS, or HOURS (permission): an hourly type is limited by its monthly quota only, never the ledger.
  unit                String   @default("DAYS")
  /// UNLIMITED = no balance (LOP, permission): only the monthly quota limits it.
  accrualKind         String   @default("NONE") @map("accrual_kind") // NONE | MONTHLY | YEARLY_UPFRONT | UNLIMITED
  accrualAmount       Decimal  @default(0) @map("accrual_amount") @db.Decimal(5, 1)
  maxBalance          Decimal? @map("max_balance") @db.Decimal(5, 1)
  carryForwardMax     Decimal? @map("carry_forward_max") @db.Decimal(5, 1)
  allowNegative       Boolean  @default(false) @map("allow_negative")
  requiresAttachment  Boolean  @default(false) @map("requires_attachment")
  minNoticeDays       Int      @default(0) @map("min_notice_days")
  countsOffDays       Boolean  @default(false) @map("counts_off_days")
  requiresHrApproval  Boolean  @default(false) @map("requires_hr_approval")
  /// Blanket policy per employment type: { [employmentType]: amount per accrual }; missing = accrualAmount, 0 = not eligible.
  entitlements        Json     @default("{}")
  /// Eligible (and accruing) only after this many days of service — probation.
  minServiceDays      Int      @default(0) @map("min_service_days")
  /// Per calendar month, pending + approved: at most this many days/hours, in at most this many requests.
  maxPerMonth         Decimal? @map("max_per_month") @db.Decimal(5, 1)
  maxRequestsPerMonth Int?     @map("max_requests_per_month")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at") // set by the api_set_updated_at trigger (post-init/007)

  requests LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, updatedAt, id])
  @@map("leave_types")
}

/// Append-only. Balance = SUM(delta) (view leave_balances).
model LeaveLedger {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  employeeId  String   @map("employee_id")
  leaveTypeId String   @map("leave_type_id")
  leaveYear   Int      @map("leave_year")
  delta       Decimal  @db.Decimal(5, 1)
  kind        String // OPENING | ACCRUAL | DEBIT | REVERSAL | ADJUSTMENT | CARRY_FORWARD | LAPSE | COMP_CREDIT
  requestId   String?  @map("request_id")
  /// Idempotency key for jobs, e.g. "ACCRUAL:2026-10", "CF:2027".
  periodKey   String?  @map("period_key")
  note        String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([employeeId, leaveTypeId, periodKey])
  @@index([employeeId, leaveYear])
  @@map("leave_ledger")
}

model LeaveRequest {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  employeeId        String    @map("employee_id")
  leaveTypeId       String    @map("leave_type_id")
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime  @map("end_date") @db.Date
  startHalf         String?   @map("start_half") // FIRST | SECOND
  endHalf           String?   @map("end_half")
  /// Hourly types only: local "HH:mm" on startDate, and the length. `days` is 0 for these.
  startTime         String?   @map("start_time")
  endTime           String?   @map("end_time")
  minutes           Int?
  days              Decimal   @db.Decimal(5, 1)
  reason            String?
  attachmentKey     String?   @map("attachment_key")
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  managerApproverId String?   @map("manager_approver_id")
  managerDecidedAt  DateTime? @map("manager_decided_at")
  approverId        String?   @map("approver_id")
  decidedAt         DateTime? @map("decided_at")
  decisionNote      String?   @map("decision_note")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @map("updated_at") // set by the api_set_updated_at trigger (post-init/007)

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, updatedAt, id])
  @@index([employeeId, startDate])
  @@map("leave_requests")
}

model RemoteWorkRequest {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  employeeId        String    @map("employee_id")
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime  @map("end_date") @db.Date
  reason            String?
  status            String    @default("PENDING")
  /// Two-level approval (org setting remoteRequiresHrApproval): the manager's step.
  managerApproverId String?   @map("manager_approver_id")
  managerDecidedAt  DateTime? @map("manager_decided_at")
  approverId        String?   @map("approver_id")
  decidedAt         DateTime? @map("decided_at")
  decisionNote      String?   @map("decision_note")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([employeeId, startDate])
  @@map("remote_work_requests")
}

// ── Reports ─────────────────────────────────────────────────────────────────

model ReportJob {
