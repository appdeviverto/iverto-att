  tenantId       String   @map("tenant_id")
  announcementId String   @map("announcement_id")
  employeeId     String   @map("employee_id")
  ackAt          DateTime @default(now()) @map("ack_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, employeeId])
  @@map("announcement_acks")
}

// ── Payroll ─────────────────────────────────────────────────────────────────
// Money is integer paise throughout.

/// components: [{ code, name, kind: EARNING|DEDUCTION, calc: FIXED|PCT_GROSS|PCT_BASIC|BALANCE, value, prorate }]
model SalaryStructure {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  name       String
  components Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  salaries EmployeeSalary[]

  @@unique([tenantId, name])
  @@map("salary_structures")
}

/// Effective-dated: the row with the latest effectiveFrom ≤ period end applies.
model EmployeeSalary {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  employeeId    String   @map("employee_id")
  effectiveFrom DateTime @map("effective_from") @db.Date
  structureId   String   @map("structure_id")
  monthlyGross  Int      @map("monthly_gross")
  /// { componentCode: monthly paise } replacing the structure's calculation.
  overrides     Json     @default("{}")
  pf            Boolean  @default(true)
  esi           Boolean  @default(true)
  pt            Boolean  @default(true)
  ptState       String?  @map("pt_state")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  structure SalaryStructure @relation(fields: [structureId], references: [id])

  @@unique([employeeId, effectiveFrom])
  @@map("employee_salaries")
}

model PayrollAdjustment {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  employeeId String   @map("employee_id")
  /// Payroll month label "YYYY-MM".
  month      String
  kind       String // EARNING | DEDUCTION
  code       String // BONUS | INCENTIVE | ARREARS | ADVANCE | OTHER
  amount     Int
  note       String?
  payslipId  String?  @map("payslip_id")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, month])
  @@map("payroll_adjustments")
}

/// Salary advance / loan recovered as an EMI deduction each run until repaid.
model EmployeeLoan {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  employeeId String   @map("employee_id")
  principal  Int
  emi        Int
  startMonth String   @map("start_month")
  status     String   @default("ACTIVE") // ACTIVE | CLOSED
  note       String?
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_loans")
}

/// One per pay period. periodStart/periodEnd are frozen at creation (cycle settings may change later).
model PayrollRun {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  month       String
  periodStart DateTime  @map("period_start") @db.Date
  periodEnd   DateTime  @map("period_end") @db.Date
  status      String    @default("DRAFT") // DRAFT | APPROVED | PAID
  lockedAt    DateTime? @map("locked_at")
  totals      Json      @default("{}")
  warnings    Json      @default("[]")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  computedAt  DateTime  @default(now()) @map("computed_at")
  approvedBy  String?   @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  paidBy      String?   @map("paid_by")
  paidAt      DateTime? @map("paid_at")

  payslips Payslip[]

  @@unique([tenantId, month])
  @@index([tenantId, periodStart])
  @@map("payroll_runs")
}

model Payslip {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  runId           String   @map("run_id")
  employeeId      String   @map("employee_id")
  /// Frozen payable-days inputs.
  attendance      Json
  /// [{ code, name, kind: EARNING|DEDUCTION|EMPLOYER, amount }]
  lines           Json
  gross           Int
  deductions      Int
  net             Int
  employerContrib Int      @map("employer_contrib")
  paymentMode     String   @default("BANK") @map("payment_mode")
  createdAt       DateTime @default(now()) @map("created_at")

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

// ── Public API (docs/public-api.md) ─────────────────────────────────────────

/// A developer API key. Only an HMAC of the secret is stored; the plaintext is shown once.
model ApiKey {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  /// Public lookup half of ivk_live_<keyId>_<secret><crc>.
  keyId           String    @unique @map("key_id")
  secretHash      String    @map("secret_hash")
  hashAlgo        String    @default("hmac-sha256") @map("hash_algo")
  pepperVersion   Int       @default(1) @map("pepper_version")
  last4           String
  name            String
  description     String?
  purpose         String?
  integratorName  String?   @map("integrator_name")
  environment     String    @default("live") // live | test
  /// Iverto-Version pinned at creation.
  apiVersion      String    @map("api_version")
  /// Permission ids from public-api/registry.ts.
  scopes          String[]
  /// Empty = every site.
  siteIds         String[]  @map("site_ids")
  /// CIDRs; empty = any address (unless the org policy requires one).
  ipAllowlist     String[]  @map("ip_allowlist")
  rateLimitPerMin Int?      @map("rate_limit_per_min")
  /// Monthly credits this key may spend (credits must be on for the org).
  creditCap       Int?      @map("credit_cap")
  piiAccess       Boolean   @default(false) @map("pii_access")
  status          String    @default("ACTIVE") // PENDING_APPROVAL | ACTIVE | DISABLED | REVOKED
  disabledReason  String?   @map("disabled_reason")
  expiresAt       DateTime? @map("expires_at")
  rotatedFromId   String?   @map("rotated_from_id")
  lastUsedAt      DateTime? @map("last_used_at")
  lastUsedIp      String?   @map("last_used_ip")
  /// Ed25519 public key (base64, 32 raw bytes) for optional request signing (§2).
  signingPublicKey String?  @map("signing_public_key")
  /// Refuse unsigned requests once a signing key is set.
  requireSignature Boolean  @default(false) @map("require_signature")
  createdBy       String    @map("created_by")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  revokedBy       String?   @map("revoked_by")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("api_keys")
}

/// Append-only. tenantId null = platform default; the highest version per tenant is in force; policy null = inherit the default.
model ApiPolicyVersion {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id")
  version   Int
  policy    Json?
  note      String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, version])
  @@map("api_policy_versions")
}

/// One row per public API request. INSERT/SELECT only for the app role (post-init/007).
model ApiRequestLog {
  id          String   @id // = X-Request-Id
  tenantId    String?  @map("tenant_id")
  apiKeyId    String?  @map("api_key_id")
  operationId String?  @map("operation_id")
  method      String
  path        String
  status      Int
  errorCode   String?  @map("error_code")
  latencyMs   Int      @map("latency_ms")
  reqBytes    Int      @default(0) @map("req_bytes")
  resBytes    Int      @default(0) @map("res_bytes")
  ip          String?
  userAgent   String?  @map("user_agent")
  credits     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([apiKeyId, createdAt(sort: Desc)])
  @@map("api_request_logs")
}

/// Credit top-ups and adjustments. Spend is SUM(api_request_logs.credits) for the month.
model ApiCreditLedger {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  /// YYYY-MM the grant applies to.
  month     String
  delta     Int
  reason    String // TOPUP | ADJUSTMENT
  note      String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, month])
  @@map("api_credit_ledger")
}

/// Tombstones for incremental sync, written by the api_tombstone trigger (post-init/007).
model DeletedRecord {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @map("tenant_id")
  resource  String
  recordId  String   @map("record_id")
  siteId    String?  @map("site_id")
  deletedAt DateTime @default(now()) @map("deleted_at")

  @@index([tenantId, resource, deletedAt, recordId])
  @@map("deleted_records")
}

/// Outbox + event log (docs/public-api.md §10). Rows are written by triggers (post-init/008)
/// in the same transaction as the change, only for tenants that use the API. 30-day retention.
model ApiEvent {
  id           String    @id // evt_<32 hex>
  tenantId     String    @map("tenant_id")
  siteId       String?   @map("site_id")
  type         String
  data         Json
  /// ping only: delivered to this endpoint instead of fanned out.
  endpointId   String?   @map("endpoint_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  dispatchedAt DateTime? @map("dispatched_at")

  deliveries WebhookDelivery[]

  @@index([tenantId, createdAt, id])
  @@map("api_events")
}

model WebhookEndpoint {
  id                      String    @id @default(cuid())
  tenantId                String    @map("tenant_id")
  url                     String
  description             String?
  /// Event types from public-api/registry.ts EVENTS; explicit, no wildcards.
  events                  String[]
  /// AES-256-GCM, key derived from the API pepper (webhooks.ts).
  secretEncrypted         String    @map("secret_encrypted")
  previousSecretEncrypted String?   @map("previous_secret_encrypted")
  previousSecretUntil     DateTime? @map("previous_secret_until")
  status                  String    @default("ACTIVE") // ACTIVE | DISABLED
  disabledReason          String?   @map("disabled_reason")
  /// First failure of the current failing streak; null when the last delivery succeeded.
  failingSince            DateTime? @map("failing_since")
  createdBy               String    @map("created_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

/// One event to one endpoint; holds the latest attempt. 30-day retention.
model WebhookDelivery {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  endpointId      String    @map("endpoint_id")
  eventId         String    @map("event_id")
  status          String    @default("PENDING") // PENDING | SUCCEEDED | FAILED
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now()) @map("next_attempt_at")
  /// Claimed by a sender until then; a crashed sender's claim simply expires.
  lockedUntil     DateTime? @map("locked_until")
  responseStatus  Int?      @map("response_status")
  /// First 1 KB of the response body, never parsed.
  responseSnippet String?   @map("response_snippet")
  latencyMs       Int?      @map("latency_ms")
  error           String?
  deliveredAt     DateTime? @map("delivered_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event    ApiEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt(sort: Desc)])
  @@index([eventId])
  @@map("webhook_deliveries")
}

/// Async work started through the public API (docs/public-api.md §12): bulk employee upserts run
/// by public-api/jobs.ts; report jobs wrap a ReportJob, whose status a trigger copies here
/// (post-init/009). 30-day retention.
model ApiJob {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  apiKeyId    String    @map("api_key_id")
  type        String // employees.bulk_upsert | report
  status      String    @default("QUEUED") // QUEUED | RUNNING | SUCCEEDED | PARTIALLY_SUCCEEDED | FAILED
  input       Json
  /// { processed, total }
  progress    Json      @default("{}")
  result      Json?
  /// { code, message } when FAILED.
  error       Json?
  reportJobId String?   @unique @map("report_job_id")
  /// Rows finished (bulk): a crashed worker resumes here.
  checkpoint  Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime  @map("expires_at")

  @@index([tenantId, createdAt, id])
  @@index([status, type])
  @@map("api_jobs")
}

/// Usage alerts and key hygiene (docs/public-api.md §15). Also the 24 h throttle: one per (tenant, key, type, level).
model ApiAlert {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  apiKeyId  String?  @map("api_key_id")
  /// rate_limit | quota | credits | key_expiring | key_stale | key_disabled | webhook_failing | error_spike | auth_anomaly
  type      String
  level     String   @default("warning") // warning | critical
  message   String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, type, createdAt])
  @@map("api_alerts")
}
