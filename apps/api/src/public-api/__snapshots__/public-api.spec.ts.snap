                          "none",
                          "department",
                          "site",
                        ],
                        "type": "string",
                      },
                      "siteIds": {
                        "items": {
                          "type": "string",
                        },
                        "type": "array",
                      },
                    },
                    "required": [
                      "dateFrom",
                      "dateTo",
                    ],
                    "type": "object",
                  },
                  "format": {
                    "enum": [
                      "csv",
                      "pdf",
                    ],
                    "type": "string",
                  },
                  "type": {
                    "enum": [
                      "daily-summary",
                      "muster-roll",
                      "payable-days",
                      "timesheet",
                      "punch-log",
                      "late-early",
                      "overtime",
                      "leave",
                      "absenteeism",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "type",
                  "format",
                  "filters",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job",
                },
              },
            },
            "description": "Accepted: a job",
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error (problem+json)",
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Server error (problem+json)",
          },
        },
        "summary": "Generate a report file (async job)",
        "tags": [
          "Jobs",
        ],
        "x-cost": 25,
        "x-permission": "reports:generate",
      },
    },
    "/sites": {
      "get": {
        "description": "Permission: \`org:read\` (Read sites and departments). Cost: 1 unit.",
        "operationId": "sites.list",
        "parameters": [
          {
            "description": undefined,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "description": "nextCursor of the previous page",
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Incremental sync: rows changed at or after this instant, plus deletions (as \`deleted: true\` items)",
            "in": "query",
            "name": "updatedSince",
            "schema": {
              "format": "date-time",
              "type": "string",
            },
          },
          {
            "description": "Request signing (optional): unix seconds",
            "in": "header",
            "name": "Iverto-Timestamp",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Request signing (optional): base64 Ed25519 signature",
            "in": "header",
            "name": "Iverto-Signature",
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/Site",
                          },
                          {
                            "$ref": "#/components/schemas/Deleted",
                          },
                        ],
                      },
                      "type": "array",
                    },
                    "hasMore": {
                      "type": "boolean",
                    },
                    "nextCursor": {
                      "description": "Pass as \`cursor\`. Keep the last one: it resumes the sync later",
                      "nullable": true,
                      "type": "string",
                    },
                    "object": {
                      "enum": [
                        "list",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "object",
                    "data",
                    "hasMore",
                    "nextCursor",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "304": {
            "description": "Not modified (If-None-Match); costs nothing",
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error (problem+json)",
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Server error (problem+json)",
          },
        },
        "summary": "List sites",
        "tags": [
          "Organisation",
        ],
        "x-cost": 1,
        "x-permission": "org:read",
      },
    },
  },
