    "/employees/bulk": {
      "post": {
        "description": "Iverto finds each record by \`employeeCode\`. If the record has no code, Iverto uses \`externalId\`. Iverto checks the values with the same rules as the CSV import in the web app. To get the result, send \`GET /jobs/{id}\` or use the \`job.completed\` webhook.

Permission: \`employees:write\` (Create and update employees in bulk).

Cost: 10 units of your rate limit.",
        "operationId": "employees.bulk_upsert",
        "parameters": [
          {
            "description": "A unique value for each new action. If you send the request again with the same key and body, you get the first response.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 200,
              "type": "string",
            },
          },
          {
            "description": "Optional. For request signing: the current time in Unix seconds.",
            "in": "header",
            "name": "Iverto-Timestamp",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Optional. For request signing: the Ed25519 signature in base64.",
            "in": "header",
            "name": "Iverto-Signature",
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "onInvalid": {
                    "description": "skip (default): Iverto saves the correct records. reject: if one record is incorrect, Iverto saves no records.",
                    "enum": [
                      "skip",
                      "reject",
                    ],
                    "type": "string",
                  },
                  "records": {
                    "description": "The employee records. Fields: \`employeeCode\`, \`externalId\`, \`fullName\`, \`joinedOn\`, \`siteId\`, \`departmentId\`, \`managerEmployeeCode\`, \`designation\`, \`employmentType\`, \`mobilePunch\`, \`email\`, \`phone\`, \`probationEndOn\`, \`confirmedOn\`, \`noticePeriodDays\`. With PII access, you can also send date of birth, gender, addresses, emergency contact, \`pan\`, \`aadhaarLast4\`, \`uan\`, \`esicNumber\` and bank fields. If you do not send a field, Iverto keeps the current value. If you send \`null\`, Iverto removes the value.",
                    "items": {
                      "additionalProperties": true,
                      "type": "object",
                    },
                    "maxItems": 5000,
                    "minItems": 1,
                    "type": "array",
                  },
                  "validateOnly": {
                    "description": "If true, Iverto checks the records and tells you the result. It does not change data.",
                    "type": "boolean",
                  },
                },
                "required": [
                  "records",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job",
                },
              },
            },
            "description": "Accepted. The response is a job.",
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error in the request. See the code field.",
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error on the server. Try again later.",
          },
        },
        "summary": "Create or update employees in bulk (job)",
        "tags": [
          "Employees",
        ],
        "x-cost": 10,
        "x-permission": "employees:write",
      },
    },
