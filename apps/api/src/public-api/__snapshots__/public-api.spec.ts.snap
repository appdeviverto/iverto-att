  "info": {
    "description": "Attendance, leave and employee data for payroll, ERP, HR and access-control integrations. Server-to-server only.",
    "title": "Iverto Attend API",
    "version": "2026-12-01",
  },
  "openapi": "3.0.3",
  "paths": {
    "/attendance-days": {
      "get": {
        "description": "Permission: \`attendance:read\` (Read attendance days). Cost: 1 unit.",
        "operationId": "attendance_days.list",
        "parameters": [
          {
            "description": undefined,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "type": "integer",
            },
          },
