    "/punches": {
      "get": {
        "description": "Historical punches by \`from\`/\`to\` (when people punched). To catch punches a terminal uploads late (it buffers while offline and sends the backlog on reconnect, with the original punch times), sync with \`updatedSince\`/\`cursor\`, which follow when Iverto stored or changed each punch.

Permission: \`punches:read\` (Read punches). Cost: 1 unit.",
        "operationId": "punches.list",
        "parameters": [
          {
            "description": undefined,
            "in": "query",
