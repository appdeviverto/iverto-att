    "/employees/bulk": {
      "post": {
        "description": "Matches by \`employeeCode\`, or by \`externalId\` when the code is left out. Validated like the CSV import in the web app. Poll the job or subscribe to \`job.completed\`.

Permission: \`employees:write\` (Create and update employees in bulk). Cost: 10 units.",
        "operationId": "employees.bulk_upsert",
        "parameters": [
          {
            "description": "Unique per logical write; a retry with the same key and body returns the first response",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 200,
              "type": "string",
            },
          },
          {
            "description": "Request signing (optional): unix seconds",
            "in": "header",
            "name": "Iverto-Timestamp",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Request signing (optional): base64 Ed25519 signature",
            "in": "header",
            "name": "Iverto-Signature",
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "onInvalid": {
                    "description": "skip (default): apply the valid records. reject: write nothing if any record is invalid",
                    "enum": [
                      "skip",
                      "reject",
                    ],
                    "type": "string",
                  },
                  "records": {
                    "description": "Fields: \`employeeCode\`, \`externalId\`, \`fullName\`, \`joinedOn\`, \`siteId\`, \`departmentId\`, \`managerEmployeeCode\`, \`designation\`, \`employmentType\`, \`mobilePunch\`, \`email\`, \`phone\`, \`probationEndOn\`, \`confirmedOn\`, \`noticePeriodDays\`; with PII access also date of birth, gender, addresses, emergency contact, \`pan\`, \`aadhaarLast4\`, \`uan\`, \`esicNumber\` and bank fields. A field left out is kept; \`null\` clears it.",
                    "items": {
                      "additionalProperties": true,
                      "type": "object",
                    },
                    "maxItems": 5000,
                    "minItems": 1,
                    "type": "array",
                  },
                  "validateOnly": {
                    "description": "Report what would happen; write nothing",
                    "type": "boolean",
                  },
                },
                "required": [
                  "records",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job",
                },
              },
            },
            "description": "Accepted: a job",
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error (problem+json)",
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Server error (problem+json)",
          },
        },
        "summary": "Create or update up to 1,000 employees (async job)",
        "tags": [
          "Employees",
        ],
        "x-cost": 10,
        "x-permission": "employees:write",
      },
    },
