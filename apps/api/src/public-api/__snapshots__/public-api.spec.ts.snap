                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Punch",
                },
              },
            },
            "description": "OK",
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error in the request. See the code field.",
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error on the server. Try again later.",
          },
        },
        "summary": "Record a punch",
        "tags": [
          "Punches",
        ],
        "x-cost": 1,
        "x-permission": "punches:write",
      },
    },
    "/reports": {
      "post": {
        "description": "Permission: \`reports:generate\` (Generate attendance reports (CSV / PDF)).

Cost: 25 units of your rate limit.",
        "operationId": "reports.create",
        "parameters": [
          {
            "description": "A unique value for each new action. If you send the request again with the same key and body, you get the first response.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 200,
              "type": "string",
            },
          },
          {
            "description": "Optional. For request signing: the current time in Unix seconds.",
            "in": "header",
            "name": "Iverto-Timestamp",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Optional. For request signing: the Ed25519 signature in base64.",
            "in": "header",
            "name": "Iverto-Signature",
            "schema": {
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "filters": {
                    "properties": {
                      "dateFrom": {
                        "format": "date",
                        "type": "string",
                      },
                      "dateTo": {
                        "format": "date",
                        "type": "string",
                      },
                      "departmentIds": {
                        "items": {
                          "type": "string",
                        },
                        "type": "array",
                      },
                      "employeeIds": {
                        "items": {
                          "type": "string",
                        },
                        "type": "array",
                      },
                      "groupBy": {
                        "enum": [
                          "none",
                          "department",
                          "site",
                        ],
                        "type": "string",
                      },
                      "siteIds": {
                        "items": {
                          "type": "string",
                        },
                        "type": "array",
                      },
                    },
                    "required": [
                      "dateFrom",
                      "dateTo",
                    ],
                    "type": "object",
                  },
                  "format": {
                    "enum": [
                      "csv",
                      "pdf",
                    ],
                    "type": "string",
                  },
                  "type": {
                    "enum": [
                      "daily-summary",
                      "muster-roll",
                      "payable-days",
                      "timesheet",
                      "punch-log",
                      "late-early",
                      "overtime",
                      "leave",
                      "absenteeism",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "type",
                  "format",
                  "filters",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job",
                },
              },
            },
            "description": "Accepted. The response is a job.",
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error in the request. See the code field.",
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error on the server. Try again later.",
          },
        },
        "summary": "Make a report file (job)",
        "tags": [
          "Jobs",
        ],
        "x-cost": 25,
        "x-permission": "reports:generate",
      },
    },
    "/sites": {
      "get": {
        "description": "Permission: \`org:read\` (Read sites and departments).

Cost: 1 unit of your rate limit.",
        "operationId": "sites.list",
        "parameters": [
          {
            "description": "The number of items on one page.",
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "description": "The nextCursor value from the previous page.",
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Get only the items that changed at or after this time. Deleted items come back with deleted: true.",
            "in": "query",
            "name": "updatedSince",
            "schema": {
              "format": "date-time",
              "type": "string",
            },
          },
          {
            "description": "Optional. For request signing: the current time in Unix seconds.",
            "in": "header",
            "name": "Iverto-Timestamp",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "Optional. For request signing: the Ed25519 signature in base64.",
            "in": "header",
            "name": "Iverto-Signature",
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/Site",
                          },
                          {
                            "$ref": "#/components/schemas/Deleted",
                          },
                        ],
                      },
                      "type": "array",
                    },
                    "hasMore": {
                      "type": "boolean",
                    },
                    "nextCursor": {
                      "description": "Send this value as cursor to get the next page. Keep the last value for the next synchronization.",
                      "nullable": true,
                      "type": "string",
                    },
                    "object": {
                      "enum": [
                        "list",
                      ],
                      "type": "string",
                    },
                  },
                  "required": [
                    "object",
                    "data",
                    "hasMore",
                    "nextCursor",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "OK",
          },
          "304": {
            "description": "Not modified. Nothing changed since the ETag that you sent in If-None-Match. It costs nothing.",
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error in the request. See the code field.",
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem",
                },
              },
            },
            "description": "Error on the server. Try again later.",
          },
        },
        "summary": "List sites",
        "tags": [
          "Organisation",
        ],
        "x-cost": 1,
        "x-permission": "org:read",
      },
    },
  },
