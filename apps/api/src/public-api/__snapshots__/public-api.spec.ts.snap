              "format": "date-time",
              "type": "string",
            },
          },
          {
            "description": undefined,
            "in": "query",
            "name": "employeeId",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": undefined,
            "in": "query",
            "name": "siteId",
            "schema": {
              "type": "string",
            },
          },
          {
            "description": "punchedAt ≥ from",
